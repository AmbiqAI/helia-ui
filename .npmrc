# Travels with the split repository so the standalone clone carries the same
# guard as the monorepo: the engines range in package.json is enforced rather
# than advisory. The ranges here are floors below what this repository develops
# against, because a consumer installing from a git tag reads this package.json
# as a dependency manifest and would fail its own strict install on the tighter
# range. See the root .npmrc for the lockfile dialect this is guarding against,
# and README.md "Install" for why the pin cannot live in both places.
engine-strict=true
