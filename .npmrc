# Travels with the split repository so the standalone clone carries the same
# guard as the monorepo: the engines range in package.json is enforced rather
# than advisory. The range is the one pair this package is developed and tested
# against, and a consumer installing from a git tag reads that package.json as
# a dependency manifest, so a strict install tells them the requirement up
# front. See the root .npmrc for the lockfile dialect this is guarding against.
engine-strict=true
