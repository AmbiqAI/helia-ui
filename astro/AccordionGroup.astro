---
// SPDX-License-Identifier: BSD-3-Clause
// Copyright (c) 2026, Ambiq
/**
 * A stack of disclosure rows: one `<details>` per item, the first one open.
 *
 * The rows are data rather than slots because the group owns the divider and
 * the row chrome, which a slotted `<details>` would have to redeclare. Content
 * is a single line of text for the same reason: anything that needs markup is
 * a card, not a row in a group.
 */
import { icon } from '@fortawesome/fontawesome-svg-core';
import { faChevronDown } from '@fortawesome/free-solid-svg-icons';

interface AccordionItem {
  /** The summary line, and the control that opens the row. */
  title: string;
  /** The row body. Plain text: it is rendered as one paragraph. */
  content: string;
}

interface Props {
  /** The rows, in display order. The first one renders open. */
  items: readonly AccordionItem[];
}

const { items } = Astro.props;
const chevronMarkup = icon(faChevronDown).html.join('');
---

<div class="accordion-group helia-surface">
  {
    items.map((item, index) => (
      <details open={index === 0}>
        <summary class="helia-focus-ring helia-focus-ring--inset">
          {item.title}
          <span
            class="accordion-chevron"
            aria-hidden="true"
            set:html={chevronMarkup}
          />
        </summary>
        <p>{item.content}</p>
      </details>
    ))
  }
</div>

<style>
  .accordion-group {
    overflow: hidden;
  }

  details {
    border: 0;
    border-bottom: 1px solid var(--helia-surface-border);
    margin: 0;
    padding: 0;
  }

  details:last-child {
    border-bottom: 0;
  }

  summary {
    align-items: center;
    color: var(--helia-ink-primary);
    cursor: pointer;
    display: flex;
    font-size: var(--helia-text-body);
    font-weight: var(--helia-weight-semibold);
    gap: var(--helia-space-4);
    justify-content: space-between;
    list-style: none;
    margin: 0;
    min-height: var(--helia-control-lg);
    padding: var(--helia-space-3) var(--helia-space-4);
    transition: background-color var(--helia-motion-fast) var(--helia-ease-out);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::marker {
    content: '';
  }

  summary::before {
    display: none;
  }

  summary:hover {
    background: var(--helia-surface-card-muted);
  }

  .accordion-chevron {
    align-items: center;
    color: var(--helia-ink-muted);
    display: inline-flex;
    flex: 0 0 1.5rem;
    height: 1.5rem;
    justify-content: center;
    line-height: 1;
    transition: transform var(--helia-motion-fast) var(--helia-ease-out);
  }

  /* style-lint: allow global -- the chevron is set:html from Font Awesome, so the svg carries no scope */
  /* `1em` is how `Icon` draws every other glyph in the system, so the chevron
     scales with the summary instead of holding a size of its own. */
  .accordion-chevron :global(svg) {
    height: 1em;
    width: 1em;
  }

  details[open] .accordion-chevron {
    transform: rotate(180deg);
  }

  p {
    color: var(--helia-ink-secondary);
    font-size: var(--helia-text-small);
    line-height: var(--helia-leading-body);
    margin: 0;
    max-width: 46rem;
    padding: 0 calc(var(--helia-space-6) + var(--helia-space-5))
      var(--helia-space-4) var(--helia-space-4);
  }

  @media (width < 42rem) {
    summary {
      padding-inline: var(--helia-space-3);
    }

    p {
      padding: 0 var(--helia-space-3) var(--helia-space-4);
    }
  }
</style>
