/**
 * The title block of a card: an optional eyebrow, the title, optional
 * metadata under it, and an optional trailing action.
 *
 * Every region is a slot, so the header never has to know what the metadata
 * means or what the action does. A header with no title renders none, so a
 * header used for metadata alone leaves no empty heading in the outline.
 *
 * `href` makes the title the card's link, stretched over the whole card by the
 * recipe. It lives here rather than on `Card` because an anchor around the card
 * would swallow the links and buttons the other parts carry.
 *
 * The title holds the card-title step and the regions are one space step apart.
 * A composition that needs other values sets `--helia-card-title-size`,
 * `--helia-card-title-leading` or `--helia-card-header-gap` on the header or above
 * it.
 *
 * The leading mark is how a card stands up without artwork: an `icon` slot for
 * a tonal disc, or `step` for the numeral one an ordered flow needs. They are
 * the same disc, so a row mixing the two lines up; a header handed both keeps
 * the icon, because two marks in one corner is neither.
 *
 * A region whose slot renders to nothing is left out, so a caller passing one
 * of them behind a condition leaves no empty disc or metadata line.
 *
 * @slot default -- The title text. Omit it and no heading is rendered.
 * @slot icon -- A glyph for the tonal disc before the title, usually an `Icon`.
 * @slot eyebrow -- The label above the title, for markup `eyebrow` cannot carry.
 * @slot meta -- Metadata under the title, such as a date or an author.
 * @slot action -- A trailing control, aligned to the top right of the header.
 */
import type { HTMLAttributes } from 'astro/types';
import {
  escapeRendition,
  linkItem,
  renditionAttributes,
  renditionText,
} from '../rendition';
import type { PaddingStep } from './Surface.astro';
import Eyebrow from './Eyebrow.astro';

interface Props extends HTMLAttributes<'div'> {
  /** Heading level for the title. Pick the one the page outline needs. */
  titleAs?: 'h2' | 'h3' | 'h4';
  /** Inner padding, named by spacing step. `card` follows the density dial; `none` leaves the part to own its gaps. */
  padding?: PaddingStep;
  /** Links the title, and stretches that link over the whole card. */
  href?: string;
  /**
   * The eyebrow text. Prefer this to the `eyebrow` slot in MDX: MDX merges a
   * slotted element and the title text that follows it into one paragraph,
   * which drops the `slot` attribute and folds the eyebrow into the heading's
   * accessible name. The slot stays for markup an attribute cannot carry.
   */
  eyebrow?: string;
  /** The position in an ordered flow, rendered as a numeral in the leading disc. */
  step?: number | string;
  /** `display` takes the title and eyebrow up a step, for a card standing in for a hero. */
  scale?: 'default' | 'display';
  /**
   * Whether the header states the card's line for the page's markdown
   * rendition. Set it false in a part that wraps this one and states the whole
   * card itself, the way `LinkCard` does; a card stated twice reaches an agent
   * as two cards.
   */
  rendition?: boolean;
}

const {
  titleAs: Title = 'h3',
  padding = 'card',
  href,
  eyebrow,
  step,
  scale = 'default',
  rendition = true,
  class: className,
  ...rest
} = Astro.props;

/*
 * Astro binds a slot name where the caller is compiled, not where its branch
 * runs, so a caller that wraps a slot in a condition registers the name either
 * way and `has` is true for a region with nothing in it. The optional regions
 * are rendered once here and whitespace counts as absent, which is what keeps
 * a card given no icon from drawing an empty disc.
 * See AmbiqAI/helia-ui#101.
 */
const rendered = async (name: string) =>
  Astro.slots.has(name) ? await Astro.slots.render(name) : '';

const icon = await rendered('icon');
const meta = await rendered('meta');
const action = await rendered('action');
/*
 * The title is the children, so a card whose title comes from a record states
 * nothing about itself in the source a rendition is reduced from. Rendered
 * once here and written back, for the same reason the regions above are.
 */
const title = await rendered('default');

const hasTitle = Astro.slots.has('default');
const hasEyebrow = eyebrow !== undefined || Astro.slots.has('eyebrow');
const hasMeta = meta.trim() !== '';
const hasAction = action.trim() !== '';
const hasIcon = icon.trim() !== '';
const hasStep = !hasIcon && step !== undefined;
/* A header with no title states nothing rather than an empty link; the block
   is still written, because what anchors a sidecar to the component it came
   from is the count of them matching the source's. */
const stated = renditionText(title);
---

<div
  class:list={[
    'helia-card-header',
    scale === 'display' && 'helia-card-header--display',
    padding !== 'none' && `helia-surface--pad-${padding}`,
    className,
  ]}
  {...rest}
>
  {
    hasIcon && (
      <span class="helia-card-mark helia-card-mark--icon">
        <Fragment set:html={icon} />
      </span>
    )
  }
  {hasStep && <span class="helia-card-mark helia-card-mark--text">{step}</span>}
  <div class="helia-card-header__text">
    {
      hasEyebrow && (
        <Eyebrow>
          {eyebrow}
          <slot name="eyebrow" />
        </Eyebrow>
      )
    }
    {
      hasTitle && (
        <Title class="helia-card-header__title">
          {href ? (
            <a class="helia-card-header__link" href={href}>
              <Fragment set:html={title} />
            </a>
          ) : (
            <Fragment set:html={title} />
          )}
        </Title>
      )
    }
    {
      hasMeta && (
        <div class="helia-card-header__meta">
          <Fragment set:html={meta} />
        </div>
      )
    }
  </div>
  {
    hasAction && (
      <div class="helia-card-header__action">
        <Fragment set:html={action} />
      </div>
    )
  }
  {
    href !== undefined && rendition && (
      <script
        is:inline
        {...renditionAttributes('card')}
        set:html={escapeRendition(stated === '' ? '' : linkItem(stated, href))}
      />
    )
  }
</div>
