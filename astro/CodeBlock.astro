/**
 * A code sample rendered through Expressive Code: the highlighted source in a
 * frame, with the frame's own copy control.
 *
 * A wrapper over Expressive Code rather than a frame of its own. The Starlight
 * plugin themes fenced blocks, and a page that mixes a fence with this part has
 * to show one object, not two; anything styled here would reopen that split.
 * The part stays because it is the form a component can render from data, and
 * because `filename`, `label` and `lineNumbers` have no fence spelling.
 */
import { Code } from '@astrojs/starlight/components';

type CodeLanguage =
  | 'bash'
  | 'c'
  | 'cpp'
  | 'diff'
  | 'json'
  | 'plaintext'
  | 'python'
  | 'sh'
  | 'tsx'
  | 'typescript';

interface Props {
  /** The source, verbatim. It is also what the copy control puts on the clipboard. */
  code: string;
  /** Grammar to highlight with. */
  language?: CodeLanguage;
  /** Path shown in the frame's title. Takes precedence over `label`. */
  filename?: string;
  /** Frame title when there is no `filename`. With neither, the frame carries
   * no visible title; a terminal frame is still named to assistive technology. */
  label?: string;
  /** 1-based line numbers to mark as changed or worth reading first. */
  highlightLines?: readonly number[];
  /** Renders the line-number gutter. */
  lineNumbers?: boolean;
  /** `code` is the framed default, `terminal` the shell form, `bare` drops the
   * frame, leaving the highlighted source on its own. */
  variant?: 'bare' | 'code' | 'terminal';
  /** Forwarded to the frame, so a layout can size it without reaching inside. */
  class?: string;
}

const {
  code,
  language = 'plaintext',
  filename,
  label,
  highlightLines = [],
  lineNumbers = false,
  variant = 'code',
  class: className,
} = Astro.props;

const FRAMES = { bare: 'none', code: 'code', terminal: 'terminal' } as const;

/*
 * A gutter needs `@expressive-code/plugin-line-numbers`, which the package does
 * not depend on. The class hands the job to the counter rule in starlight.css,
 * which fills the gutter column the core stylesheet already lays out.
 */
const classes = [className, lineNumbers && 'helia-code-lines']
  .filter(Boolean)
  .join(' ');
---

<Code
  class={classes || undefined}
  code={code}
  frame={FRAMES[variant]}
  lang={language}
  mark={highlightLines.length > 0 ? [...highlightLines] : undefined}
  title={filename ?? label}
/>
