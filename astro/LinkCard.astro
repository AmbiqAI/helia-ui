/**
 * A whole card that is one link: a title, a line about it, and a cue that
 * moves when the card is under the pointer.
 *
 * The link lives on the title and the recipe stretches it over the card, which
 * is why the card itself is not an anchor. The cue sits inside that link so it
 * is part of the same hit area, and it is hidden from assistive technology:
 * the title already says where the card goes.
 *
 * The title is a prop rather than the child because the child is the line of
 * description, which is prose and wants the paragraph MDX gives it.
 *
 * `tone="ink"` is the inked tile: the ground goes dark in both themes and the
 * title, which is the link, takes the accent. One of them in a set, because
 * that is the whole of what the accent budget allows a mosaic.
 *
 * The mark and the metadata line are `CardHeader`'s, passed straight through:
 * a row of link cards that needs either one is the same card, not a
 * composition written out again beside it.
 *
 * @slot default -- The line of description under the title.
 * @slot icon -- A glyph for the tonal disc before the title, usually an `Icon`.
 */
import type { HTMLAttributes } from 'astro/types';
import type { CardTone } from './Card.astro';
import Card from './Card.astro';
import CardContent from './CardContent.astro';
import CardHeader from './CardHeader.astro';

interface Props extends Omit<HTMLAttributes<'div'>, 'title'> {
  /** Where the card goes. */
  href: string;
  /** The link text, and the card's accessible name. */
  title: string;
  /** Heading level. Pick the one the page outline needs. */
  titleAs?: 'h2' | 'h3' | 'h4';
  /** The label above the title. */
  eyebrow?: string;
  /** One line of metadata under the title, such as a date or a source. */
  meta?: string;
  /** What stands in for the card's edge and fill. Passed straight to `Card`. `ink` takes the accent on the title. */
  tone?: CardTone;
  /** Moves the padding step the parts default to. Passed straight to `Card`. */
  density?: 'default' | 'compact' | 'comfortable';
  /** Adds the hover lift. Passed straight to `Card`. */
  lift?: boolean;
}

const {
  href,
  title,
  titleAs = 'h3',
  eyebrow,
  meta,
  class: className,
  ...rest
} = Astro.props;

const hasLine = Astro.slots.has('default');
---

<Card interactive class:list={['helia-link-card', className]} {...rest}>
  <CardHeader titleAs={titleAs} href={href} eyebrow={eyebrow}>
    <slot name="icon" slot="icon" />
    <span class="title"
      >{title}<span class="helia-motion-cue" aria-hidden="true">→</span></span
    >
    <Fragment slot="meta">{meta}</Fragment>
  </CardHeader>
  {
    hasLine && (
      <CardContent>
        <slot />
      </CardContent>
    )
  }
</Card>

<style>
  .title {
    align-items: baseline;
    display: inline-flex;
    gap: var(--helia-space-2);
  }
</style>
