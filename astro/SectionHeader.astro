// Copyright (c) 2026, Ambiq
/**
 * The heading of a page section: an optional label, the title, an optional
 * line under it, and an optional link to the fuller view.
 *
 * Everything is a prop rather than a slot because the header is a fixed
 * arrangement, not a container: the trailing link sits on the baseline of the
 * title block, which only works if the header knows both.
 *
 * The title defaults to an `<h2>`, so the part belongs to a page section
 * rather than to a card; `titleAs` moves it where the page outline needs
 * something else.
 */
import type { HTMLAttributes } from 'astro/types';
import Eyebrow from './Eyebrow.astro';

interface Props extends Omit<HTMLAttributes<'header'>, 'title'> {
  /** The uppercase label above the title. */
  eyebrow?: string;
  /** The section's heading. Required. */
  title: string;
  /** Heading level for the title. Pick the one the page outline needs. */
  titleAs?: 'h2' | 'h3' | 'h4';
  /** One line about the section, under the title. */
  description?: string;
  /** Where the trailing link goes. Without it, no link renders. */
  href?: string;
  /** The trailing link's text. Ignored without `href`. */
  linkLabel?: string;
}

const {
  eyebrow,
  title,
  titleAs: Title = 'h2',
  description,
  href,
  linkLabel = 'View all',
  class: className,
  ...rest
} = Astro.props;
---

<header class:list={['section-header', className]} {...rest}>
  <div class="text">
    {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
    <Title class="title">{title}</Title>
    {description && <p class="description">{description}</p>}
  </div>
  {
    href && (
      <a href={href}>
        {linkLabel}{' '}
        <span class="helia-motion-cue" aria-hidden="true">
          →
        </span>
      </a>
    )
  }
</header>

<style>
  .section-header {
    align-items: end;
    display: flex;
    gap: var(--helia-space-6);
    justify-content: space-between;
    margin: calc(var(--helia-space-6) + var(--helia-space-5)) 0
      var(--helia-space-4);
  }

  /* The label is the `Eyebrow` part's and carries no margin of its own, so the
     step between the three lines is the column's gap rather than a rule this
     header has to reach into the part to write. */
  .text {
    display: grid;
    gap: var(--helia-space-2);
  }

  .title {
    font-size: var(--helia-text-section);
    margin: 0;
  }

  .description {
    color: var(--sl-color-gray-2);
    margin: 0;
    max-width: 42rem;
  }

  a {
    flex: none;
    font-size: var(--helia-text-small);
    font-weight: var(--helia-weight-semibold);
    text-decoration: none;
  }

  @media (width < 42rem) {
    .section-header {
      align-items: start;
      flex-direction: column;
      gap: var(--helia-space-3);
    }
  }
</style>
