/**
 * The heading of a page section: an optional label, the title, an optional
 * line under it, and an optional link to the fuller view.
 *
 * Everything is a prop rather than a slot because the header is a fixed
 * arrangement, not a container: the trailing link sits on the baseline of the
 * title block, which only works if the header knows both.
 *
 * The title is an `<h2>`, so the part belongs to a page section rather than to
 * a card.
 */
interface Props {
  /** The uppercase label above the title. */
  eyebrow?: string;
  /** The section's heading. Required. */
  title: string;
  /** One line about the section, under the title. */
  description?: string;
  /** Where the trailing link goes. Without it, no link renders. */
  href?: string;
  /** The trailing link's text. Ignored without `href`. */
  linkLabel?: string;
}

const {
  eyebrow,
  title,
  description,
  href,
  linkLabel = 'View all',
} = Astro.props;
---

<header class="section-header">
  <div>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2>{title}</h2>
    {description && <p class="description">{description}</p>}
  </div>
  {
    href && (
      <a href={href}>
        {linkLabel}{' '}
        <span class="helia-motion-cue" aria-hidden="true">
          →
        </span>
      </a>
    )
  }
</header>

<style>
  .section-header {
    align-items: end;
    display: flex;
    gap: var(--helia-space-6);
    justify-content: space-between;
    margin: calc(var(--helia-space-6) + var(--helia-space-5)) 0
      var(--helia-space-4);
  }

  .eyebrow {
    color: var(--sl-color-accent-high);
    font-size: var(--helia-text-caption);
    font-weight: var(--helia-weight-bold);
    letter-spacing: var(--helia-tracking-caps);
    margin: 0 0 var(--helia-space-2);
    text-transform: uppercase;
  }

  h2 {
    font-size: var(--helia-text-section);
    margin: 0;
  }

  .description {
    color: var(--sl-color-gray-2);
    margin: var(--helia-space-2) 0 0;
    max-width: 42rem;
  }

  a {
    flex: none;
    font-size: var(--helia-text-small);
    font-weight: var(--helia-weight-semibold);
    text-decoration: none;
  }

  @media (width < 42rem) {
    .section-header {
      align-items: start;
      flex-direction: column;
      gap: var(--helia-space-3);
    }
  }
</style>
