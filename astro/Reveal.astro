/**
 * Entry animation for whatever it wraps: a short fade and rise the first time
 * the element reaches the viewport.
 *
 * The hidden state is a class the script adds, never the resting state of the
 * recipe, so the content is visible without JavaScript and visible again the
 * moment the script decides not to run. The script reads the same
 * `--helia-motion-scale` the transitions do and returns before arming anything
 * when it is 0, which is what a site turning motion off, and a visitor asking
 * for reduced motion, both amount to.
 *
 * Use it on a section, not on every card in one: a page where each element
 * arrives separately reads as a page that is still loading. `stagger` is the
 * exception that proves it -- one wrapper, one arrival, told across the grid.
 *
 * @slot default -- The content to reveal. Visible without JavaScript.
 */
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> {
  /**
   * How much of the element has to be in view before it reveals, 0 to 1.
   * Lower it for a tall section that would otherwise never cross the mark.
   */
  threshold?: number;
  /**
   * Cascade the direct children instead of revealing the wrapper as one
   * block: each child waits one `--helia-motion-fast` step longer than the
   * one before it, to a ceiling of six. Use it on a grid of cards.
   */
  stagger?: boolean;
}

const {
  threshold = 0.15,
  stagger = false,
  class: className,
  ...rest
} = Astro.props;
---

<helia-reveal
  class:list={[
    'helia-motion-reveal',
    stagger && 'helia-motion-reveal--stagger',
    className,
  ]}
  data-threshold={threshold}
  data-stagger={stagger ? '' : undefined}
  {...rest}
>
  <slot />
</helia-reveal>

<script>
  /*
   * Where the cascade stops. Past the sixth child the wait is longer than the
   * arrival itself, and a grid that is still filling in after the reader has
   * started on it reads as a page that has not finished loading.
   */
  const MAX_STEP = 5;

  class HeliaReveal extends HTMLElement {
    #observer: IntersectionObserver | null = null;

    connectedCallback() {
      const scale = Number.parseFloat(
        getComputedStyle(this).getPropertyValue('--helia-motion-scale'),
      );
      // NaN means the token never resolved, which is a site without the
      // stylesheets. Nothing would animate anyway, so leave the content alone.
      if (!(scale > 0)) return;

      const threshold = Number.parseFloat(this.dataset.threshold ?? '');

      if (this.dataset.stagger !== undefined) {
        // The index is the only per-child value: the delay itself stays a
        // multiple of the token, in the sheet.
        Array.from(this.children).forEach((child, index) => {
          (child as HTMLElement).style.setProperty(
            '--helia-motion-reveal-step',
            String(Math.min(index, MAX_STEP)),
          );
        });
      }

      this.classList.add('helia-motion-reveal--armed');

      this.#observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add('helia-motion-reveal--in');
            this.#observer?.unobserve(entry.target);
          }
        },
        { threshold: Number.isFinite(threshold) ? threshold : 0.15 },
      );

      this.#observer.observe(this);
    }

    disconnectedCallback() {
      this.#observer?.disconnect();
    }

    /**
     * Hide the content again and wait for the next arrival. Does nothing on an
     * element that never armed, so a visitor with motion off cannot be handed
     * a reveal by a control that replays one.
     */
    replay() {
      if (!this.#observer) return;
      this.#observer.unobserve(this);
      this.classList.remove('helia-motion-reveal--in');
      // The hidden state has to be painted before the observer may put it
      // back: re-observing in this frame resolves against the same style
      // recalculation and the transition never starts.
      requestAnimationFrame(() => {
        requestAnimationFrame(() => this.#observer?.observe(this));
      });
    }
  }

  if (!customElements.get('helia-reveal')) {
    customElements.define('helia-reveal', HeliaReveal);
  }
</script>

<style>
  helia-reveal {
    display: block;
  }
</style>
