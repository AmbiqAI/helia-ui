---
// SPDX-License-Identifier: BSD-3-Clause
// Copyright (c) 2026, Ambiq
/**
 * A full-bleed band across the content column: the paint reaches the viewport
 * edges while the text stays on the readable measure.
 *
 * It is the one part that deliberately escapes its container, which is how a
 * long page gets a change of ground without the site owning a second layout.
 * Consecutive bands butt against each other rather than stacking a gap, so a
 * run of them reads as one alternating rhythm.
 *
 * `tone` picks which ground the band paints; `--helia-hero-treatment` decides
 * what that ground is made of, which is the site theme's say rather than the
 * caller's. The two are independent: a `base` band has nothing to treat.
 *
 * @slot default -- The band's content, held to the readable width.
 */
interface Props {
  /** The ground. `base` is the page background; `paper` and `subtle` both paint the paper fill. */
  tone?: 'base' | 'paper' | 'subtle';
  /** Anchor for the section, so a nav or a deep link can reach it. */
  id?: string;
}

const { tone = 'base', id } = Astro.props;
---

<section class:list={['editorial-band', `editorial-band--${tone}`]} id={id}>
  <div class="editorial-band__inner">
    <slot />
  </div>
</section>

<style>
  /* style-lint: allow-file global -- resets the spacing of the markdown slotted into the band */
  .editorial-band {
    box-sizing: border-box;
    margin-inline: calc(50% - 50cqw - var(--sl-content-pad-x));
    /*
     * The geometry belongs to the band, not to the tone or the treatment:
     * every band reserves the same gutter and the same rhythm, so a plain one
     * and a painted one put their first line on the same baseline. Only the
     * ground below changes.
     */
    padding: clamp(2.25rem, 6vw, 4.5rem) clamp(1rem, 4vw, 2.5rem);
    width: calc(100cqw + 2 * var(--sl-content-pad-x));
  }

  .editorial-band + .editorial-band {
    margin-top: 0;
  }

  .editorial-band--paper,
  .editorial-band--subtle {
    --band-ground: var(--helia-surface-paper);

    background: var(--band-ground);
    /*
     * Starlight may reserve a desktop column outside `.content-panel`. Extend
     * the surface paint through that space without moving the readable inner
     * content or introducing horizontal overflow.
     */
    box-shadow: 0 0 0 100vmax var(--band-bleed, var(--band-ground));
    clip-path: inset(0 -100vmax);
  }

  /*
   * The hero treatment. A style query rather than a prop because the value is
   * the site's, set once on `:root` or on a theme scope, and a caller passing
   * it per band is how twelve sites end up with twelve heroes.
   *
   * `tinted` pulls the site accent into the ground. `gradient` runs the two
   * accents across the band, and needs a separate bleed colour: a box-shadow
   * takes a colour and not a gradient, so the reserved column gets the two
   * accents mixed rather than either end of the run.
   */
  @container style(--helia-hero-treatment: tinted) {
    .editorial-band--paper,
    .editorial-band--subtle {
      --band-ground: color-mix(
        in srgb,
        var(--helia-product-accent) 8%,
        var(--helia-surface-paper)
      );
    }
  }

  @container style(--helia-hero-treatment: gradient) {
    .editorial-band--paper,
    .editorial-band--subtle {
      --band-bleed: color-mix(
        in srgb,
        color-mix(
            in srgb,
            var(--helia-product-accent),
            var(--helia-accent-secondary)
          )
          10%,
        var(--helia-surface-paper)
      );

      background: linear-gradient(
        100deg,
        color-mix(
          in srgb,
          var(--helia-product-accent) 12%,
          var(--helia-surface-paper)
        ),
        color-mix(
          in srgb,
          var(--helia-accent-secondary) 12%,
          var(--helia-surface-paper)
        )
      );
    }
  }

  .editorial-band__inner {
    margin-inline: auto;
    max-width: var(--sl-content-width);
  }

  :global(.editorial-band__inner > :first-child) {
    margin-top: 0;
  }

  :global(.editorial-band__inner > :last-child) {
    margin-bottom: 0;
  }
</style>
