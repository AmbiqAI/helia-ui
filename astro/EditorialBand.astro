/**
 * A full-bleed band across the content column: the paint reaches the viewport
 * edges while the text stays on the readable measure.
 *
 * It is the one part that deliberately escapes its container, which is how a
 * long page gets a change of ground without the site owning a second layout.
 * Consecutive bands butt against each other rather than stacking a gap, so a
 * run of them reads as one alternating rhythm.
 *
 * The geometry and the rhythm are `Band`'s: this part wears `.helia-band` and
 * `.helia-band__inner`, so the two kinds of band on one page sit on the same
 * measure and the same vertical step. What it adds is the ground, which it
 * takes from `--helia-hero-treatment` rather than from the caller.
 *
 * `tone` picks whether the band paints at all; the treatment decides what that
 * paint is made of, which is the site theme's say. The two are independent: a
 * `base` band has nothing to treat.
 *
 * @slot default -- The band's content, held to the readable width.
 */
interface Props {
  /** The ground. `base` is the page background; `paper` paints the paper fill. */
  tone?: 'base' | 'paper';
  /** Anchor for the section, so a nav or a deep link can reach it. */
  id?: string;
}

const { tone = 'base', id } = Astro.props;
---

<section
  class:list={[
    'helia-band',
    'editorial-band',
    tone !== 'base' && `editorial-band--${tone}`,
  ]}
  id={id}
>
  <div class="helia-band__inner">
    <slot />
  </div>
</section>

<style>
  /*
   * The gutter is the one piece of geometry the recipe cannot supply: there it
   * arrives with the ground, and here every band reserves it, so a plain band
   * and a painted one put their first line on the same baseline.
   */
  .editorial-band {
    padding-inline: clamp(1rem, 4vw, 2.5rem);
  }

  .editorial-band--paper {
    --band-ground: var(--helia-surface-paper);

    background: var(--band-ground);
    /*
     * A layout may reserve a column outside `.content-panel`. Extend the
     * surface paint through that space without moving the readable inner
     * content or introducing horizontal overflow.
     *
     * `--helia-band-bleed-end` caps that carry at the end of the band's own
     * box: a layout that parks a table of contents beside the reading frame
     * sets it to zero, because that column is not the frame. Same dial as the
     * recipe band, so a layout states it once for both.
     */
    box-shadow: 0 0 0 100vmax var(--band-bleed, var(--band-ground));
    clip-path: inset(
      0 calc(-1 * var(--helia-band-bleed-end, 100vmax)) 0 -100vmax
    );
  }

  /*
   * The hero treatment. A style query rather than a prop because the value is
   * the site's, set once on `:root` or on a theme scope, and a caller passing
   * it per band is how twelve sites end up with twelve heroes.
   *
   * `tinted` pulls the site accent into the ground. `gradient` runs the two
   * accents across the band, and needs a separate bleed color: a box-shadow
   * takes a color and not a gradient, so the reserved column gets the two
   * accents mixed rather than either end of the run.
   */
  @container style(--helia-hero-treatment: tinted) {
    .editorial-band--paper {
      --band-ground: color-mix(
        in srgb,
        var(--helia-product-accent) 8%,
        var(--helia-surface-paper)
      );
    }
  }

  @container style(--helia-hero-treatment: gradient) {
    .editorial-band--paper {
      --band-bleed: color-mix(
        in srgb,
        color-mix(
            in srgb,
            var(--helia-product-accent),
            var(--helia-accent-secondary)
          )
          10%,
        var(--helia-surface-paper)
      );

      background: linear-gradient(
        100deg,
        color-mix(
          in srgb,
          var(--helia-product-accent) 12%,
          var(--helia-surface-paper)
        ),
        color-mix(
          in srgb,
          var(--helia-accent-secondary) 12%,
          var(--helia-surface-paper)
        )
      );
    }
  }
</style>
