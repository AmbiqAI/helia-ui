/**
 * A full-bleed band across the content column: the paint reaches the viewport
 * edges while the text stays on the readable measure.
 *
 * It is the one part that deliberately escapes its container, which is how a
 * long page gets a change of ground without the site owning a second layout.
 * Consecutive bands butt against each other rather than stacking a gap, so a
 * run of them reads as one alternating rhythm.
 *
 * @slot default -- The band's content, held to the readable width.
 */
interface Props {
  /** The ground. `base` is the page background; `paper` and `subtle` both paint the paper fill. */
  tone?: 'base' | 'paper' | 'subtle';
  /** Anchor for the section, so a nav or a deep link can reach it. */
  id?: string;
}

const { tone = 'base', id } = Astro.props;
---

<section class:list={['editorial-band', `editorial-band--${tone}`]} id={id}>
  <div class="editorial-band__inner">
    <slot />
  </div>
</section>

<style>
  /* style-lint: allow-file global -- resets the spacing of the markdown slotted into the band */
  .editorial-band {
    box-sizing: border-box;
    margin-inline: calc(50% - 50cqw - var(--sl-content-pad-x));
    padding: clamp(2.25rem, 6vw, 4.5rem) 0;
    width: calc(100cqw + 2 * var(--sl-content-pad-x));
  }

  .editorial-band + .editorial-band {
    margin-top: 0;
  }

  .editorial-band--paper,
  .editorial-band--subtle {
    background: var(--helia-surface-paper);
    /*
     * Starlight may reserve a desktop column outside `.content-panel`. Extend
     * the surface paint through that space without moving the readable inner
     * content or introducing horizontal overflow.
     */
    box-shadow: 0 0 0 100vmax var(--helia-surface-paper);
    clip-path: inset(0 -100vmax);
    padding-inline: clamp(1rem, 4vw, 2.5rem);
  }

  .editorial-band__inner {
    margin-inline: auto;
    max-width: var(--sl-content-width);
  }

  :global(.editorial-band__inner > :first-child) {
    margin-top: 0;
  }

  :global(.editorial-band__inner > :last-child) {
    margin-bottom: 0;
  }
</style>
