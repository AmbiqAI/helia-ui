---
/**
 * The card surface: hairline border, shared radius, one of three backgrounds.
 *
 * The recipe itself is `.helia-surface` in `src/styles/global.css`. Reach for the
 * class directly when the element cannot be produced by this component -- a
 * grid `<li>`, a Starlight shell override, a wrapper generated by markdown.
 * The bare class carries no padding, so an element that already owns its
 * layout keeps it.
 */
import type { HTMLAttributes, HTMLTag } from 'astro/types';

/** Spacing scale step names, plus `none` for a surface that pads its own children. */
export type PaddingStep = 'none' | 'px' | '1' | '2' | '3' | '4' | '5' | '6';

interface Props extends HTMLAttributes<'div'> {
  /** Element to render. Ignored when `href` is set. */
  as?: HTMLTag;
  /** Background: the raised card, the recessed muted fill, or paper. */
  tone?: 'card' | 'muted' | 'paper';
  /** Inner padding, named by spacing step. */
  padding?: PaddingStep;
  /** Adds the shared hover background shift and the focus-visible ring. */
  interactive?: boolean;
  /** Renders an `<a>` regardless of `as`. */
  href?: string;
}

const {
  as = 'div',
  tone = 'card',
  padding = '4',
  interactive = false,
  href,
  class: className,
  ...rest
} = Astro.props;

const Element = href ? 'a' : as;
---

<Element
  class:list={[
    'helia-surface',
    tone !== 'card' && `helia-surface--${tone}`,
    padding !== 'none' && `helia-surface--pad-${padding}`,
    interactive && ['helia-hover-surface', 'helia-focus-ring'],
    className,
  ]}
  href={href}
  {...rest}
>
  <slot />
</Element>
