/**
 * A terminal transcript: a fixed set of lines, optionally typed out on entry,
 * with optional copy and replay controls.
 *
 * The transcript is data, not a slot, because the component reconstructs the
 * plain-text form for the clipboard and for the typing animation, and it can
 * only do that if it knows where each line starts and what kind it is.
 *
 * The default form is inert and ships no behavior. Setting `animated`, `copy`
 * or `replay` opts the page into the inline script.
 *
 * An interactive instance exposes `play()`, which starts the animation the way
 * the replay control does and resolves when the run ends. It waits for the
 * element to be set up, so it is safe to call before the transcript's own
 * markup has been parsed.
 */
export type AsciiTerminalLineKind =
  'command' | 'muted' | 'output' | 'success' | 'warning' | 'error';

export interface AsciiTerminalLine {
  /** The line as it is read and as it is copied, without the prompt. */
  text: string;
  /** What the line is. Only `command` is typed out and given a prompt. */
  kind?: AsciiTerminalLineKind;
  /** Prompt in front of a `command` line. Ignored on every other kind. */
  prompt?: string;
}

import { codeFence, escapeRendition, renditionAttributes } from '../rendition';

interface Props {
  /** The transcript, in order. */
  lines: readonly AsciiTerminalLine[];
  /** The frame's caption. */
  title?: string;
  /** Accessible name for the frame. Defaults to the title plus `transcript`. */
  ariaLabel?: string;
  /** Types the command lines out on entry. Reduced motion shows them at once. */
  animated?: boolean;
  /** Starts the animation when the frame scrolls into view. Needs `animated`. */
  autoplay?: boolean;
  /**
   * Adds the copy control. `true` or `'transcript'` copies the whole transcript
   * as plain text, prompts included; `'commands'` copies only the command
   * lines, without prompts, which is what a reader pastes into a shell.
   */
  copy?: boolean | 'transcript' | 'commands';
  /** Adds the replay control. Defaults to whatever `animated` is. */
  replay?: boolean;
  /** `adaptive` follows the site theme; `light` and `dark` are fixed. */
  tone?: 'adaptive' | 'light' | 'dark';
  /** Milliseconds per typed character. 0 types a command line instantly. */
  typingSpeed?: number;
  /** Milliseconds of pause after each line. 0 runs the lines together. */
  lineDelay?: number;
}

const {
  lines,
  title = 'Terminal',
  ariaLabel = `${title} transcript`,
  animated = false,
  autoplay = true,
  copy = false,
  replay = animated,
  tone = 'adaptive',
  typingSpeed = 28,
  lineDelay = 130,
} = Astro.props;

/*
 * The whole behavior layer is optional, and the default form -- a static
 * transcript with no controls -- has to cost nothing. A hoisted `<script>` is
 * bundled for every page that imports the component whether or not it renders,
 * so the only way to make the cost conditional is `is:inline`. The price is
 * that a page with several interactive terminals repeats the source; the
 * `customElements.get` guard means only the first copy defines anything.
 */
/* `true` keeps the original meaning of the flag; the string forms name it. A
   value outside the contract renders no control rather than a control that
   quietly copies the wrong thing. */
const copyMode =
  copy === true || copy === 'transcript'
    ? 'transcript'
    : copy === 'commands'
      ? 'commands'
      : null;
const copyLabel =
  copyMode === 'commands' ? 'Copy commands' : 'Copy terminal transcript';
/* A commands control on a transcript with no command lines would copy an
   empty string and report success, so it is not rendered. */
const hasCopy =
  copyMode === 'transcript' ||
  (copyMode === 'commands' && lines.some((line) => line.kind === 'command'));
const interactive = animated || hasCopy || replay;

/*
 * Held as a string and written with `set:html` so the element renders the
 * source verbatim. An expression child of a `<script>` is escaped, which would
 * turn every arrow and comparison in here into an entity.
 */
const BEHAVIOR = `
(() => {
  if (customElements.get('helia-ascii-terminal')) return;

  const copyText = async (text) => {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const textarea = document.createElement('textarea');
      textarea.value = text;
      textarea.setAttribute('readonly', '');
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.append(textarea);
      textarea.select();
      const copied = document.execCommand('copy');
      textarea.remove();
      return copied;
    }
  };

  const wait = (duration) =>
    new Promise((resolve) => window.setTimeout(resolve, duration));

  class HeliaAsciiTerminal extends HTMLElement {
    constructor() {
      super();
      this.runId = 0;
      this.hasPlayed = false;
      this.isReady = false;
      this.awaitingChildren = false;
      /* A clone carries the ready attribute, and a consumer's own load
         listener can run before this one, so readiness is an instance fact and
         a promise rather than something anyone can copy or race. */
      this.whenReady = new Promise((resolve) => {
        this.markReady = resolve;
      });
    }

    /*
     * The definition lives in an inline script after the first instance, so
     * every instance the parser reaches after it is upgraded on its opening
     * tag, with none of its children parsed yet. Setting up then would bind
     * nothing, and an upgrade happens once, so nothing would retry.
     */
    connectedCallback() {
      if (this.isReady || this.awaitingChildren) return;
      if (this.querySelector('[data-line]')) {
        this.setup();
        return;
      }

      this.awaitingChildren = true;
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => this.resume(), {
          once: true,
        });
        return;
      }

      /* Connected empty after the parse: a script that appends the transcript
         right after the frame gets the same setup as the parser does. */
      const observer = new MutationObserver(() => {
        if (!this.querySelector('[data-line]')) return;
        observer.disconnect();
        this.resume();
      });
      observer.observe(this, { childList: true, subtree: true });
    }

    resume() {
      this.awaitingChildren = false;
      this.setup();
    }

    async play() {
      await this.whenReady;
      return this.run();
    }

    setup() {
      if (this.isReady) return;
      this.isReady = true;
      this.dataset.ready = 'true';

      const lines = Array.from(this.querySelectorAll('[data-line]'));
      const copyButton = this.querySelector('[data-copy-button]');
      const replayButton = this.querySelector('[data-replay-button]');
      const transcript =
        this.querySelector('[data-transcript]')?.textContent ?? '';
      const status = this.querySelector('[data-status]');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      /* The commands mode copies what a reader pastes into a shell: the
         command lines alone, without prompts or the output between them. The
         lines carry their text as data, so the markup needs no second copy of
         the transcript. */
      const copyMode = copyButton?.dataset.copyMode ?? 'transcript';
      const commands = lines
        .filter((line) => line.dataset.kind === 'command')
        .map((line) => line.dataset.text ?? '')
        .join('\\n');
      const clipboardText = copyMode === 'commands' ? commands : transcript;
      const subject =
        copyMode === 'commands' ? 'commands' : 'terminal transcript';
      const idleLabel = 'Copy ' + subject;
      const doneLabel =
        copyMode === 'commands' ? 'Commands copied' : 'Terminal transcript copied';

      copyButton?.addEventListener('click', async () => {
        const copied = await copyText(clipboardText);
        if (!status) return;
        if (!copied) {
          status.textContent = 'Unable to copy ' + subject;
          return;
        }

        copyButton.dataset.copied = 'true';
        copyButton.setAttribute('aria-label', doneLabel);
        copyButton.title = doneLabel;
        status.textContent = doneLabel;
        window.setTimeout(() => {
          delete copyButton.dataset.copied;
          copyButton.setAttribute('aria-label', idleLabel);
          copyButton.title = idleLabel;
          status.textContent = '';
        }, 2400);
      });

      const showCompleteTranscript = () => {
        this.runId += 1;
        this.removeAttribute('data-playing');
        lines.forEach((line) => {
          const text = line.querySelector('[data-line-text]');
          if (text) text.textContent = line.dataset.text || ' ';
          line.dataset.state = 'visible';
        });
      };

      const play = async () => {
        if (reducedMotion.matches || this.dataset.animate !== 'true') {
          showCompleteTranscript();
          return;
        }

        const currentRun = ++this.runId;
        const typingSpeed = Number(this.dataset.typingSpeed ?? 28);
        const lineDelay = Number(this.dataset.lineDelay ?? 130);
        this.dataset.enhanced = 'true';
        this.dataset.playing = 'true';
        this.hasPlayed = true;

        lines.forEach((line) => {
          const text = line.querySelector('[data-line-text]');
          if (text) text.textContent = '';
          line.dataset.state = 'pending';
        });

        for (const line of lines) {
          if (currentRun !== this.runId) return;
          const text = line.querySelector('[data-line-text]');
          const value = line.dataset.text ?? '';
          if (!text) continue;

          line.dataset.state = 'visible';
          if (line.dataset.kind === 'command') {
            line.dataset.active = 'true';
            for (const character of value) {
              if (currentRun !== this.runId) return;
              text.textContent += character;
              if (typingSpeed > 0) await wait(typingSpeed);
            }
            delete line.dataset.active;
          } else {
            text.textContent = value || ' ';
          }

          if (lineDelay > 0) await wait(lineDelay);
        }

        if (currentRun === this.runId) this.removeAttribute('data-playing');
      };

      /* The replay control is markup; a consumer driving the transcript from
         its own script reaches the same run through the play method, which
         waits on this. */
      this.run = play;
      this.markReady();

      replayButton?.addEventListener('click', () => {
        if (status) status.textContent = '';
        void play();
      });

      reducedMotion.addEventListener('change', (event) => {
        if (event.matches) showCompleteTranscript();
      });

      if (this.dataset.animate !== 'true') return;
      if (reducedMotion.matches) {
        showCompleteTranscript();
        return;
      }

      this.dataset.enhanced = 'true';
      if (this.dataset.autoplay !== 'true') return;

      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting) || this.hasPlayed)
            return;
          observer.disconnect();
          void play();
        },
        { threshold: 0.35 },
      );
      observer.observe(this);
    }
  }

  customElements.define('helia-ascii-terminal', HeliaAsciiTerminal);
})();
`;

const normalizedLines = lines.map((line) => ({
  kind: line.kind ?? 'output',
  prompt: line.kind === 'command' ? (line.prompt ?? '$') : '',
  text: line.text,
}));
const transcript = normalizedLines
  .map((line) =>
    line.kind === 'command'
      ? `${line.prompt}${line.prompt ? ' ' : ''}${line.text}`
      : line.text,
  )
  .join('\n');
---

<helia-ascii-terminal
  aria-label={ariaLabel}
  class:list={[
    'ascii-terminal',
    'helia-surface',
    'not-content',
    `tone-${tone}`,
  ]}
  data-animate={animated ? 'true' : 'false'}
  data-autoplay={autoplay ? 'true' : 'false'}
  data-line-delay={Math.max(0, lineDelay)}
  data-typing-speed={Math.max(0, typingSpeed)}
  role="region"
>
  <div class="ascii-terminal__toolbar">
    <span class="ascii-terminal__title">{title}</span>
    <div class="ascii-terminal__actions">
      {
        replay && (
          <button
            aria-label="Replay terminal animation"
            class="helia-focus-ring"
            title="Replay terminal animation"
            type="button"
            data-replay-button
          >
            <svg aria-hidden="true" viewBox="0 0 20 20">
              <path d="M16.5 7.25A7 7 0 1 0 17 11" />
              <path d="M16.5 3.5v3.75h-3.75" />
            </svg>
          </button>
        )
      }
      {
        hasCopy && (
          <button
            aria-label={copyLabel}
            class="helia-focus-ring"
            title={copyLabel}
            type="button"
            data-copy-button
            data-copy-mode={copyMode}
          >
            <svg aria-hidden="true" class="copy-icon" viewBox="0 0 20 20">
              <path d="M6.25 6.25V4.5A1.75 1.75 0 0 1 8 2.75h7.5a1.75 1.75 0 0 1 1.75 1.75V12A1.75 1.75 0 0 1 15.5 13.75h-1.75" />
              <rect x="2.75" y="6.25" width="11" height="11" rx="1.75" />
            </svg>
            <svg aria-hidden="true" class="check-icon" viewBox="0 0 20 20">
              <path d="m4.25 10.25 3.5 3.5 8-8" />
            </svg>
          </button>
        )
      }
    </div>
  </div>

  <div class="ascii-terminal__viewport">
    <pre
      aria-hidden="true"><code>{normalizedLines.map((line) => (
      <span class:list={['ascii-terminal__line', `is-${line.kind}`]} data-kind={line.kind} data-line data-text={line.text}>
        {line.kind === 'command' && (
          <span class="ascii-terminal__prompt" data-prompt>{line.prompt}</span>
        )}
        <span data-line-text>{line.text || ' '}</span>
      </span>
    ))}</code></pre>
  </div>

  {
    /* The <pre> is aria-hidden so the caret and per-line reveal are not
  announced; this carries the reading order instead, and doubles as the
  clipboard source. */
  }
  <span class="helia-sr-only" data-transcript>{transcript}</span>
  {interactive && <span class="helia-sr-only" aria-live="polite" data-status />}

  {
    /* The transcript is the whole of what this part is worth to a reader, and
       a page that imports its lines states none of it in its source. */
  }
  <script
    is:inline
    {...renditionAttributes('terminal')}
    set:html={escapeRendition(codeFence(transcript))}
  />

  {interactive && <script is:inline set:html={BEHAVIOR} />}
</helia-ascii-terminal>

<style>
  /* style-lint: allow-file color -- the light and dark tones are fixed terminal palettes that must not follow the site theme */
  .ascii-terminal {
    --ascii-bg: var(--helia-surface-card);
    --ascii-border: var(--helia-surface-border);
    --ascii-ink: var(--helia-ink-primary);
    --ascii-muted: var(--helia-ink-muted);
    --ascii-prompt: var(--helia-product-accent, var(--helia-accent-cyan));
    --ascii-success: var(--helia-tone-success-ink);
    --ascii-warning: var(--helia-tone-warning-ink);
    --ascii-error: var(--helia-tone-critical-ink);
    --helia-surface-border-color: var(--ascii-border);
    /* A fixed tone keeps its backdrop in both themes, so the ring follows the
       terminal ink rather than the page's. */
    --helia-focus-ring-color: var(--ascii-ink);

    background: var(--ascii-bg);
    color: var(--ascii-ink);
    display: block;
    overflow: hidden;
  }

  /* The status inks restate the theme tokens rather than reading them: a
     pinned backdrop keeps its palette when the reader switches themes, and a
     theme-following ink on it would slide to the pair meant for the other
     surface and lose its contrast. */
  .tone-dark {
    --ascii-bg: #0d1017;
    --ascii-border: #2b303b;
    --ascii-toolbar-bg: #11151d;
    --ascii-ink: #f5f6f7;
    --ascii-muted: #9ca3af;
    --ascii-success: #2fb878;
    --ascii-warning: #e9a445;
    --ascii-error: #ff7b86;
  }

  .tone-light {
    --ascii-bg: var(--helia-paper-white);
    --ascii-border: #d7dade;
    --ascii-toolbar-bg: #f5f5f7;
    --ascii-ink: var(--helia-ink-black);
    --ascii-muted: #626870;
    --ascii-success: #0b7048;
    --ascii-warning: #8f5300;
    --ascii-error: #c0273a;
  }

  /* A title bar is the muted step of the surface under it, the way an
     Expressive Code frame's is. The fixed tones carry their own pair, because
     a theme-following token on a pinned palette would drift off it. */
  .ascii-terminal__toolbar {
    align-items: center;
    background: var(--ascii-toolbar-bg, var(--helia-surface-card-muted));
    border-bottom: 1px solid var(--ascii-border);
    display: flex;
    justify-content: space-between;
    min-height: 2.65rem;
    padding: var(--helia-space-1) var(--helia-space-2) var(--helia-space-1)
      var(--helia-space-3);
  }

  .ascii-terminal__title {
    color: var(--ascii-ink);
    font-size: var(--helia-text-small);
    font-weight: var(--helia-weight-semibold);
    line-height: var(--helia-leading-heading);
  }

  .ascii-terminal__actions {
    align-items: center;
    display: flex;
    gap: var(--helia-space-px);
    margin: 0;
  }

  button {
    align-items: center;
    appearance: none;
    background: transparent;
    border: 0;
    border-radius: var(--helia-radius-sm);
    color: var(--ascii-muted);
    cursor: pointer;
    display: inline-flex;
    height: 1.9rem;
    justify-content: center;
    margin: 0;
    padding: 0;
    transition:
      background-color var(--helia-motion-fast) var(--helia-ease-out),
      color var(--helia-motion-fast) var(--helia-ease-out);
    width: 1.9rem;
  }

  button:hover {
    background: color-mix(in srgb, var(--ascii-ink) 8%, transparent);
    color: var(--ascii-ink);
  }

  button svg {
    fill: none;
    height: 1rem;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.35;
    width: 1rem;
  }

  button .check-icon {
    display: none;
  }

  button[data-copied='true'] .copy-icon {
    display: none;
  }

  button[data-copied='true'] .check-icon {
    display: block;
  }

  .ascii-terminal__viewport {
    margin: 0;
    overflow: auto;
  }

  pre {
    background: var(--ascii-bg);
    border: 0;
    border-radius: 0;
    color: var(--ascii-ink);
    font-family: var(--helia-font-mono);
    /* style-lint: allow font-size -- monospace terminal ramp, not the prose scale */
    font-size: clamp(0.76rem, 1.4vw, 0.86rem);
    line-height: var(--helia-leading-body);
    margin: 0;
    min-width: max-content;
    padding: var(--helia-space-4);
  }

  code {
    color: inherit;
    font: inherit;
  }

  .ascii-terminal__line {
    align-items: baseline;
    display: flex;
    min-height: 1.55em;
    white-space: pre;
  }

  .ascii-terminal[data-enhanced='true']
    .ascii-terminal__line[data-state='pending'] {
    visibility: hidden;
  }

  .ascii-terminal__line.is-muted {
    color: var(--ascii-muted);
  }

  .ascii-terminal__line.is-success {
    color: var(--ascii-success);
  }

  .ascii-terminal__line.is-warning {
    color: var(--ascii-warning);
  }

  .ascii-terminal__line.is-error {
    color: var(--ascii-error);
  }

  .ascii-terminal__prompt {
    color: var(--ascii-prompt);
    /* style-lint: allow spacing -- em nudge, tracks the monospace glyph width */
    margin-right: 0.6em;
  }

  .ascii-terminal__line[data-active='true'] [data-line-text]::after {
    /* A blink is a cadence rather than a transition, so it multiplies the slow
       step: a site that turns the dial to 0 gets a caret that holds still. */
    animation: ascii-caret calc(var(--helia-motion-slow) * 2.5) steps(1, end)
      infinite;
    background: currentColor;
    content: '';
    display: inline-block;
    height: 1.05em;
    /* style-lint: allow spacing -- em nudge, tracks the monospace glyph width */
    margin-left: 0.16em;
    transform: translateY(0.15em);
    width: 0.5em;
  }

  @keyframes ascii-caret {
    0%,
    48% {
      opacity: 1;
    }

    49%,
    100% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ascii-terminal__line[data-active='true'] [data-line-text]::after {
      display: none;
    }
  }
</style>
