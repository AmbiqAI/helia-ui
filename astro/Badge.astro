/**
 * A read-only label on the `Chip` recipe, tinted by an advisory tone.
 *
 * The tones are semantic, not a status vocabulary: the component has no idea
 * what "beta" or "deprecated" means, and a consumer maps its own statuses onto
 * a tone. `secondary` is the exception: it is the site's second accent rather
 * than a meaning, for the label that has to pair with the first. The label is the child, and it is required: the dot only repeats the
 * tone, so a badge with nothing to say renders nothing at all rather than an
 * empty pill.
 *
 * @slot default -- The label. Required: without it the badge renders nothing.
 */
import type { HTMLAttributes } from 'astro/types';
import Chip from './Chip.astro';

interface Props extends HTMLAttributes<'span'> {
  /** The advisory tint. `neutral` and `accent` reuse the chip tones; the rest are tinted. `secondary` takes `--helia-accent-secondary`. */
  tone?:
    | 'neutral'
    | 'info'
    | 'success'
    | 'warning'
    | 'danger'
    | 'accent'
    | 'secondary';
  /** Leading status dot, drawn in the badge ink. Decorative: the label carries the meaning. */
  dot?: boolean;
  /** `sm` is the in-content metadata size, `md` the standalone one. */
  size?: 'sm' | 'md';
}

const {
  tone = 'neutral',
  dot = false,
  size = 'sm',
  class: className,
  ...rest
} = Astro.props;

const tinted = tone !== 'neutral' && tone !== 'accent';
const hasLabel = Astro.slots.has('default');
---

{
  hasLabel && (
    <Chip
      tone={tone === 'accent' ? 'accent' : 'static'}
      size={size}
      class:list={['helia-badge', tinted && `helia-badge--${tone}`, className]}
      {...rest}
    >
      {dot && <span class="helia-badge__dot" aria-hidden="true" />}
      <slot />
    </Chip>
  )
}
