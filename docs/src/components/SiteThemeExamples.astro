/**
 * The two worked themes on the Site theme page, rendered side by side.
 *
 * One list of cards, rendered once per theme, so the only thing that can
 * differ between the panels is a dial. The values are in
 * `src/styles/example-theme.css`; the density dial is an attribute rather than
 * a property, so it arrives on the wrapper the way it would arrive on `<html>`.
 *
 * `data-helia-theme` is the hook that makes the dials re-derive inside a panel
 * instead of stopping at `:root`. On a site it is not needed, because there
 * the scope is `:root`.
 */
import Badge from '@ambiqai/helia-ui/astro/Badge';
import Button from '@ambiqai/helia-ui/astro/Button';
import Card from '@ambiqai/helia-ui/astro/Card';
import CardActions from '@ambiqai/helia-ui/astro/CardActions';
import CardContent from '@ambiqai/helia-ui/astro/CardContent';
import CardHeader from '@ambiqai/helia-ui/astro/CardHeader';
import CardMedia from '@ambiqai/helia-ui/astro/CardMedia';
import Media from '@ambiqai/helia-ui/astro/Media';
import SectionHeader from '@ambiqai/helia-ui/astro/SectionHeader';

const themes = [
  {
    label: 'The hub',
    scope: 'site-theme-example--hub',
    density: undefined,
    dials: [
      '--helia-product-accent: var(--helia-accent-slate)',
      '--helia-accent-secondary: var(--helia-accent-slate)',
      '--helia-radius-scale: 1',
      '--helia-surface-tint-amount: 0%',
      '--helia-hero-treatment: plain',
      'density: unset',
    ],
  },
  {
    label: 'A warmer site',
    scope: 'site-theme-example--warm',
    density: 'comfortable',
    dials: [
      '--helia-product-accent: var(--helia-accent-orange)',
      '--helia-accent-secondary: var(--helia-accent-pink)',
      '--helia-radius-scale: 1.6',
      '--helia-surface-tint: var(--helia-accent-orange)',
      '--helia-surface-tint-amount: 7%',
      '--helia-hero-treatment: gradient',
      'data-helia-density="comfortable"',
    ],
  },
] as const;
---

<div class="site-theme-examples not-content">
  {
    themes.map((theme) => (
      <section
        class:list={['site-theme-example', theme.scope]}
        data-helia-theme={theme.scope}
        data-helia-density={theme.density}
        aria-label={`${theme.label}: the same cards under its own theme`}
      >
        <div class="site-theme-example__hero">
          <SectionHeader
            eyebrow={theme.label}
            title="Start building"
            description="Three cards, one section header, and nothing else changed."
          />
        </div>

        <div class="site-theme-example__cards">
          <Card>
            <CardMedia>
              <Media
                treatment="color-field"
                style="--accent: var(--helia-product-accent)"
              />
            </CardMedia>
            <CardHeader eyebrow="Guide" titleAs="h4">
              Install the toolchain
            </CardHeader>
          </Card>

          <Card tone="filled">
            <CardHeader eyebrow="Tutorial" titleAs="h4">
              Run the first example
            </CardHeader>
            <CardActions>
              <Button href="/helia-ui/foundations/site-theme/" size="sm">
                <span>Open</span>
              </Button>
              <Badge tone="info">15 min</Badge>
              <Badge tone="secondary">Paired</Badge>
            </CardActions>
          </Card>

          <Card tone="elevated" lift>
            <CardHeader eyebrow="Reference" titleAs="h4">
              Read the API
            </CardHeader>
            <CardContent>
              Every symbol, with the units and the error behavior.
            </CardContent>
          </Card>
        </div>

        <ul class="site-theme-example__dials">
          {theme.dials.map((dial) => (
            <li>
              <code>{dial}</code>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .site-theme-examples {
    display: grid;
    gap: var(--helia-space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    margin-top: var(--helia-space-4);
  }

  .site-theme-example {
    align-content: start;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--helia-radius-md);
    display: grid;
    gap: var(--helia-space-4);
    min-width: 0;
    padding: var(--helia-space-4);
  }

  .site-theme-example__hero {
    border-radius: var(--helia-radius-md);
    /*
     * Reserved for every treatment, as `EditorialBand` reserves it: the two
     * panels are read side by side, and padding that arrives with the paint
     * would drop the warm panel's cards a row below the hub's.
     */
    padding: var(--helia-space-3);
  }

  /*
   * `EditorialBand` reads this dial for a full-bleed band, which is not a shape
   * that fits in a side-by-side panel, so the example composes its own hero on
   * the same value the way a site would. A browser without style queries falls
   * through to the plain treatment, which is the default the dial names anyway.
   */
  @container style(--helia-hero-treatment: gradient) {
    .site-theme-example__hero {
      background: linear-gradient(
        100deg,
        color-mix(in srgb, var(--helia-product-accent) 18%, transparent),
        color-mix(in srgb, var(--helia-accent-secondary) 14%, transparent)
      );
    }
  }

  .site-theme-example__cards {
    display: grid;
    gap: var(--helia-space-3);
    min-width: 0;
  }

  .site-theme-example__dials {
    display: grid;
    gap: var(--helia-space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-theme-example__dials code {
    font-size: var(--helia-text-label);
    overflow-wrap: anywhere;
  }
</style>
