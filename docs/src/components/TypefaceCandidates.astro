---
// SPDX-License-Identifier: BSD-3-Clause
// Copyright (c) 2026, Ambiq
/*
 * A decision aid, not a part of the system: the candidate faces are imported
 * here rather than in the theme, so they load on this page alone and the
 * package default stays the system stack until the choice is made.
 * See AmbiqAI/helia-ui#16.
 */
import '@fontsource-variable/inter';
import '@fontsource-variable/geist';
import '@fontsource-variable/manrope';

type Candidate = {
  id: string;
  name: string;
  /** Licence and the on-disk size of the variable woff2, both read from node_modules. */
  licence: string;
  size: string;
};

const candidates: Candidate[] = [
  {
    id: 'system',
    name: 'System stack (current)',
    licence: 'Licence: none to carry. The stack is whatever the OS ships.',
    size: 'Download: nothing. No web font is requested.',
  },
  {
    id: 'inter',
    name: 'Inter',
    licence: 'Licence: OFL-1.1, from @fontsource-variable/inter 5.3.0.',
    size: 'Download: 47.1 KB latin subset, inter-latin-wght-normal.woff2.',
  },
  {
    id: 'geist',
    name: 'Geist',
    licence: 'Licence: OFL-1.1, from @fontsource-variable/geist 5.3.0.',
    size: 'Download: 28.7 KB latin subset, geist-latin-wght-normal.woff2.',
  },
  {
    id: 'manrope',
    name: 'Manrope',
    licence: 'Licence: OFL-1.1, from @fontsource-variable/manrope 5.3.0.',
    size: 'Download: 24.3 KB latin subset, manrope-latin-wght-normal.woff2.',
  },
];
---

<!--
  not-content on the root: Starlight gives every non-first sibling inside
  .sl-markdown-content a top margin, which would land on the grid children
  here and push each row out of line with the first.
-->
<div class="candidates not-content">
  {
    candidates.map((candidate) => (
      <section class="candidate" data-typeface={candidate.id}>
        <header class="candidate__head">
          <h2 class="candidate__name">{candidate.name}</h2>
          <p class="candidate__note">
            <span>{candidate.licence}</span>
            <span>{candidate.size}</span>
          </p>
        </header>

        <div class="specimen">
          <p class="specimen__label">Display · 650 · two trackings</p>
          <div class="tracking">
            <div class="tracking__column">
              <p class="tracking__value">-0.055em (current)</p>
              <p class="display display--current">Intelligence at the edge</p>
            </div>
            <div class="tracking__column">
              <p class="tracking__value">-0.02em</p>
              <p class="display display--loose">Intelligence at the edge</p>
            </div>
          </div>
        </div>

        <div class="specimen">
          <p class="specimen__label">H2 role · 650</p>
          {/* An h3 element carrying the H2 type role, so four candidate blocks
              do not add sixteen headings to the page outline. */}
          <h3 class="heading">Profiling a model on device</h3>
        </div>

        <div class="specimen">
          <p class="specimen__label">Body</p>
          <p class="body">
            A specimen is only useful at the size and the measure the real page
            uses, so this paragraph runs at the body role and the standard
            reading width. Look at the rhythm of the lowercase, the spacing
            either side of a comma, and the way numbers such as 0.94 and 510 sit
            against the letters around them. Then read it twice.
          </p>
        </div>

        <div class="specimen">
          <p class="specimen__label">UI</p>
          <div class="ui-row">
            <span class="ui-button">Get started</span>
            <span class="ui-badge">Variable</span>
            <span class="ui-eyebrow">Foundations</span>
            <code class="ui-mono">helia-aot compile model.onnx</code>
          </div>
        </div>
      </section>
    ))
  }
</div>

<style>
  /*
   * Sizes, weights, leading, ink and spacing all come from the token layer.
   * The two properties a candidate changes are the ones under test: the
   * family, and the tracking on the display line.
   */
  .candidates {
    display: grid;
    gap: var(--helia-space-5);
  }

  .candidate {
    background: var(--helia-surface-card);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--helia-radius-lg);
    display: grid;
    gap: var(--helia-space-4);
    padding: var(--helia-space-5);
  }

  .candidate[data-typeface='inter'] {
    font-family: 'Inter Variable', var(--helia-font-sans);
  }

  .candidate[data-typeface='geist'] {
    font-family: 'Geist Variable', var(--helia-font-sans);
  }

  .candidate[data-typeface='manrope'] {
    font-family: 'Manrope Variable', var(--helia-font-sans);
  }

  .candidate__head {
    border-bottom: 1px solid var(--sl-color-gray-5);
    display: grid;
    gap: var(--helia-space-2);
    padding-bottom: var(--helia-space-3);
  }

  .candidate__name {
    color: var(--helia-ink-primary);
    font-size: var(--helia-text-section);
    font-weight: var(--helia-weight-semibold);
    letter-spacing: -0.03em;
    line-height: var(--helia-leading-heading);
    margin: 0;
  }

  /* The note is metadata about the file rather than a specimen, so it stays in
     the UI font whatever the candidate is. */
  .candidate__note {
    color: var(--helia-ink-muted);
    display: grid;
    font-family: var(--helia-font-sans);
    font-size: var(--helia-text-small);
    gap: var(--helia-space-px);
    line-height: 1.5;
    margin: 0;
  }

  .specimen {
    display: grid;
    gap: var(--helia-space-2);
  }

  .specimen__label,
  .tracking__value {
    color: var(--helia-ink-muted);
    font-family: var(--helia-font-mono);
    font-size: var(--helia-text-label);
    letter-spacing: 0.08em;
    margin: 0;
    text-transform: uppercase;
  }

  .tracking {
    display: grid;
    gap: var(--helia-space-4);
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .tracking__column {
    display: grid;
    gap: var(--helia-space-2);
    min-width: 0;
  }

  .display {
    color: var(--helia-ink-primary);
    font-size: var(--helia-text-display);
    font-weight: var(--helia-weight-semibold);
    line-height: var(--helia-leading-tight);
    margin: 0;
  }

  .display--current {
    letter-spacing: -0.055em;
  }

  .display--loose {
    letter-spacing: -0.02em;
  }

  .heading {
    color: var(--helia-ink-primary);
    font-size: var(--helia-text-heading);
    font-weight: var(--helia-weight-semibold);
    letter-spacing: -0.02em;
    line-height: var(--helia-leading-heading);
    margin: 0;
  }

  .body {
    color: var(--helia-ink-secondary);
    font-size: var(--helia-text-body);
    line-height: var(--helia-leading-body);
    margin: 0;
    max-width: 42rem;
  }

  .ui-row {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--helia-space-3);
  }

  .ui-button {
    background: var(--helia-ink-primary);
    border-radius: var(--helia-radius-md);
    color: var(--helia-surface-card);
    font-size: var(--helia-text-body);
    font-weight: var(--helia-weight-medium);
    padding: var(--helia-space-2) var(--helia-space-4);
  }

  .ui-badge {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: var(--helia-radius-pill);
    color: var(--helia-ink-secondary);
    font-size: var(--helia-text-caption);
    font-weight: var(--helia-weight-medium);
    padding: var(--helia-space-1) var(--helia-space-3);
  }

  .ui-eyebrow {
    color: var(--helia-ink-secondary);
    font-size: var(--helia-text-label);
    font-weight: var(--helia-weight-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* Mono is not under test: every candidate shows the same system mono. */
  .ui-mono {
    background: var(--sl-color-gray-6);
    border-radius: var(--helia-radius-sm);
    color: var(--helia-ink-primary);
    font-family: var(--helia-font-mono);
    font-size: var(--helia-text-small);
    padding: var(--helia-space-1) var(--helia-space-2);
  }

  @media (width < 62rem) {
    .tracking {
      grid-template-columns: 1fr;
    }
  }
</style>
