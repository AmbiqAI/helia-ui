{
  "name": "@ambiqai/product-docs-template",
  "description": "Starting point for a HELIA product documentation site",
  "license": "BSD-3-Clause",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "playwright test",
    "//prebuild": "An API reference is generated, not written. Uncomment the line for the language the source is in, rename it to prebuild, and commit what it writes so the site builds without the toolchain.",
    "//prebuild:python": "helia-ui-pyref --input ../griffe.json --out src/content/docs/reference/api --public public --base /PRODUCT-REPO-NAME/ --sidebar src/generated/api-sidebar.json",
    "//prebuild:c": "helia-ui-doxyref --xml ../build/xml --out src/content/docs/reference/api --public public --base /PRODUCT-REPO-NAME/ --sidebar src/generated/api-sidebar.json"
  },
  "dependencies": {
    "@ambiqai/helia-ui": "github:AmbiqAI/helia-ui#v0.1.0-alpha.5",
    "@astrojs/react": "^6.0.2",
    "@astrojs/starlight": "^0.41.5",
    "@astrojs/starlight-tailwind": "5.0.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "^7.0.2",
    "katex": "^0.16.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-katex": "^7.0.1",
    "rehype-mermaid": "^3.0.0",
    "remark-math": "^6.0.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@playwright/test": "^1.62.1",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3"
  }
}
