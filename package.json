{
  "name": "@ambiqai/helia-ui",
  "version": "0.1.0-alpha.10",
  "description": "Shared HELIA design tokens and Starlight theme styling",
  "license": "BSD-3-Clause",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "validate": "npm run format:check && npm run check:spdx && npm run check:notices && npm run check:spelling && npm run check:styles && npm run check:boundaries && npm run check:islands && npm run check:shadcn-align && npm run check:astro-props && npm run check:site-theme && npm run check:foundations && npm run check:peers && npm run check:discoverability",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:spdx": "node scripts/check-spdx.mjs",
    "check:spelling": "node scripts/check-spelling.mjs",
    "notices": "node scripts/third-party-notices.mjs",
    "check:notices": "node scripts/third-party-notices.mjs --check",
    "check:styles": "node scripts/check-style-literals.mjs",
    "check:boundaries": "node scripts/check-component-boundaries.mjs",
    "check:islands": "node scripts/check-islands.mjs",
    "check:shadcn-align": "node scripts/rename-token-prefix.mjs --check",
    "check:astro-props": "node scripts/astro-props.mjs --check",
    "check:site-theme": "node scripts/site-theme-doc.mjs --check",
    "check:foundations": "node scripts/foundations-doc.mjs --check",
    "check:discoverability": "node scripts/check-discoverability.mjs --root docs --allow-missing",
    "check:peers": "node docs/scripts/check-peer-dedupe.mjs",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "docs:test": "npm --prefix docs run test",
    "test": "node --test \"scripts/**/*.test.mjs\""
  },
  "bin": {
    "helia-ui-pyref": "./scripts/pyref.mjs",
    "helia-ui-doxyref": "./scripts/doxyref.mjs",
    "helia-ui-tsref": "./scripts/tsref.mjs",
    "helia-ui-mkdocs-convert": "./scripts/mkdocs-convert.mjs",
    "helia-ui-serve-dist": "./scripts/serve-dist.mjs"
  },
  "exports": {
    "./astro/*": "./astro/*.astro",
    "./react/*": "./react/*.tsx",
    "./chart-plot-spec": "./chart-plot-spec.ts",
    "./chart-echarts-theme": "./chart-echarts-theme.ts",
    "./reference-model": "./reference-model.ts",
    "./ref-index-model": "./ref-index-model.ts",
    "./starlight": "./starlight/index.ts",
    "./starlight/*": "./starlight/*",
    "./tokens.css": "./tokens.css",
    "./semantic.css": "./semantic.css",
    "./recipes.css": "./recipes.css",
    "./site-theme.css": "./site-theme.css",
    "./starlight.css": "./starlight.css",
    "./mermaid.css": "./mermaid.css",
    "./tailwind.css": "./tailwind.css",
    "./starlight-tailwind.css": "./starlight-tailwind.css",
    "./shadcn.css": "./shadcn.css"
  },
  "files": [
    "astro",
    "chart-echarts-theme.ts",
    "chart-plot-spec.ts",
    "reference-model.ts",
    "ref-index-model.ts",
    "scripts/pyref.mjs",
    "scripts/lib/pyref-extract.mjs",
    "scripts/doxyref.mjs",
    "scripts/lib/doxyref-extract.mjs",
    "scripts/lib/xml.mjs",
    "scripts/tsref.mjs",
    "scripts/lib/tsref-extract.mjs",
    "scripts/lib/reference-render.mjs",
    "scripts/lib/markdown.mjs",
    "scripts/mkdocs-convert.mjs",
    "scripts/lib/mkdocs-convert-render.mjs",
    "scripts/lib/material-icons.json",
    "scripts/serve-dist.mjs",
    "scripts/check-discoverability.mjs",
    "react",
    "starlight",
    "*.css",
    "components.json",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD-PARTY-NOTICES.md",
    "RELEASE.md"
  ],
  "dependencies": {
    "@fontsource-variable/roboto": "5.3.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@observablehq/plot": "^0.6.17",
    "linkedom": "^0.18.13",
    "shiki": "^4.3.1"
  },
  "peerDependencies": {
    "@astrojs/starlight": "^0.41.5",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^8.21.3",
    "astro": "^7.0.2",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "echarts": "^6.1.0",
    "lucide-react": "^1.45.0",
    "radix-ui": "^1.6.7",
    "react": "^19",
    "react-dom": "^19",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3"
  },
  "peerDependenciesMeta": {
    "@astrojs/starlight-tailwind": {
      "optional": true
    },
    "@tailwindcss/vite": {
      "optional": true
    },
    "@tanstack/react-table": {
      "optional": true
    },
    "class-variance-authority": {
      "optional": true
    },
    "cmdk": {
      "optional": true
    },
    "cn": {
      "optional": true
    },
    "echarts": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "radix-ui": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "recharts": {
      "optional": true
    },
    "sonner": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.41.5",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "echarts": "^6.1.0",
    "lucide-react": "^1.45.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "radix-ui": "^1.6.7",
    "react": "^19",
    "react-dom": "^19",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
