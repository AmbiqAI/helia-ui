{
  "name": "@ambiqai/helia-ui",
  "version": "0.1.0-alpha.5",
  "description": "Shared HELIA design tokens and Starlight theme styling",
  "license": "BSD-3-Clause",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": "^10"
  },
  "scripts": {
    "validate": "npm run format:check && npm run check:spdx && npm run check:notices && npm run check:styles && npm run check:boundaries && npm run check:islands",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:spdx": "node scripts/check-spdx.mjs",
    "notices": "node scripts/third-party-notices.mjs",
    "check:notices": "node scripts/third-party-notices.mjs --check",
    "check:styles": "node scripts/check-style-literals.mjs",
    "check:boundaries": "node scripts/check-component-boundaries.mjs",
    "check:islands": "node scripts/check-islands.mjs",
    "docs:dev": "npm --prefix docs run dev",
    "docs:build": "npm --prefix docs run build",
    "docs:test": "npm --prefix docs run test",
    "test": "node --test \"scripts/**/*.test.mjs\""
  },
  "bin": {
    "helia-ui-pyref": "./scripts/pyref.mjs",
    "helia-ui-mkdocs-convert": "./scripts/mkdocs-convert.mjs"
  },
  "exports": {
    "./astro/*": "./astro/*.astro",
    "./react/*": "./react/*.tsx",
    "./starlight": "./starlight/index.ts",
    "./starlight/*": "./starlight/*",
    "./tokens.css": "./tokens.css",
    "./semantic.css": "./semantic.css",
    "./recipes.css": "./recipes.css",
    "./site-theme.css": "./site-theme.css",
    "./starlight.css": "./starlight.css",
    "./mermaid.css": "./mermaid.css",
    "./tailwind.css": "./tailwind.css",
    "./starlight-tailwind.css": "./starlight-tailwind.css",
    "./shadcn.css": "./shadcn.css"
  },
  "files": [
    "astro",
    "scripts/pyref.mjs",
    "scripts/lib/pyref-render.mjs",
    "scripts/mkdocs-convert.mjs",
    "scripts/lib/mkdocs-convert-render.mjs",
    "scripts/lib/material-icons.json",
    "react",
    "starlight",
    "*.css",
    "components.json",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD-PARTY-NOTICES.md",
    "RELEASE.md"
  ],
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "shiki": "^4.3.1"
  },
  "peerDependencies": {
    "@astrojs/starlight": "^0.41.5",
    "@astrojs/starlight-tailwind": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^8.21.3",
    "astro": "^7.0.2",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.45.0",
    "radix-ui": "^1.6.7",
    "react": "^19",
    "react-dom": "^19",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3"
  },
  "peerDependenciesMeta": {
    "@astrojs/starlight-tailwind": {
      "optional": true
    },
    "@tailwindcss/vite": {
      "optional": true
    },
    "@tanstack/react-table": {
      "optional": true
    },
    "class-variance-authority": {
      "optional": true
    },
    "cmdk": {
      "optional": true
    },
    "cn": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "radix-ui": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "recharts": {
      "optional": true
    },
    "sonner": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.41.5",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1"
  }
}
