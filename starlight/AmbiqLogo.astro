/*
 * The artwork travels with the component. Resolving it from the consuming
 * site's BASE_URL pointed the mask at a file every consumer had to place in
 * its own public directory, and a mask whose image 404s renders nothing at
 * all, so a site that had not been told simply had no wordmark.
 */
import logoUrl from './ambiq-logo.svg?url';

export type AmbiqLogoTone = 'adaptive' | 'blue' | 'black' | 'white';

interface Props {
  tone?: AmbiqLogoTone;
  label?: string;
  class?: string;
}

const { tone = 'blue', label = 'Ambiq', class: className } = Astro.props;
---

<span
  class:list={['ambiq-logo', `ambiq-logo--${tone}`, className]}
  style={`--ambiq-logo-image: url("${logoUrl}")`}
  role="img"
  aria-label={label}></span>

<style>
  /*
   * The width is a default, not a decision, and it has to be settable from
   * outside without a specificity contest. A consumer that writes `width` on
   * the element lands at the same specificity as this rule, so which one wins
   * depends on where Astro chunks the two stylesheets rather than on what the
   * consumer asked for. `--ambiq-logo-width` inherits and always wins.
   */
  .ambiq-logo {
    aspect-ratio: 1280 / 366;
    background: currentColor;
    display: inline-block;
    flex: none;
    mask: var(--ambiq-logo-image) center / contain no-repeat;
    width: var(--ambiq-logo-width, 8rem);
  }

  .ambiq-logo--blue {
    color: var(--helia-brand-ambiq-blue);
  }

  .ambiq-logo--black {
    color: var(--helia-ink-black);
  }

  .ambiq-logo--white {
    color: var(--helia-paper-white);
  }

  .ambiq-logo--adaptive {
    color: var(--helia-ink-adaptive);
  }
</style>
