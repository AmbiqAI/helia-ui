/*
 * The product top bar: the site name as text at the top-left, the sections the
 * site names beside it, search and the theme menu at the end. It is installed
 * only when the plugin is given a `header` option, and only under a key the
 * site left alone.
 *
 * The rules are in starlight.css rather than in a scoped block here. The bar is
 * part of Starlight's frame, and the frame's skins are all in that one sheet;
 * a scoped block would also put the search button and the theme menu out of
 * reach, since neither is this component's own markup.
 *
 * The narrow-width button opens the same sidebar the package's empty
 * MobileMenuToggle takes off Starlight's frame, through Starlight's own menu
 * state rather than a second one beside it: starlight.css carries the
 * `data-mobile-menu-expanded` rules it drives.
 */
import Search from '@astrojs/starlight/components/Search.astro';
import config from 'virtual:helia-ui/starlight-config';

import { matchSection } from './sections';
import ThemeMenu from './ThemeMenu.astro';

const header = config.header;
const { hasSidebar, siteTitleHref } = Astro.locals.starlightRoute;

/*
 * A prefix rather than an equality, so a link stays current on every page
 * under it, and `match` for a link whose pages do not live under its href. The
 * rule is the one the `sections` option scopes the sidebar by, so the lit link
 * and the pane below it always name the same section.
 */
const current = matchSection(
  header?.links ?? [],
  Astro.url.pathname,
  import.meta.env.BASE_URL,
);
---

{
  header && (
    <div class="helia-site-header">
      {hasSidebar && (
        <button
          class="helia-site-header__toggle"
          type="button"
          aria-label="Open navigation"
          aria-controls="starlight__sidebar"
          aria-expanded="false"
          data-helia-sidebar-toggle
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" />
          </svg>
        </button>
      )}

      <a class="helia-site-header__title" href={siteTitleHref}>
        {header.title}
      </a>

      {header.links.length > 0 && (
        <nav class="helia-site-header__nav" aria-label="Primary">
          {header.links.map((link) => (
            <a
              href={link.href}
              aria-current={link === current ? 'page' : undefined}
            >
              {link.label}
            </a>
          ))}
        </nav>
      )}

      <div class="helia-site-header__actions">
        {header.search && (
          <div class="helia-site-header__search">
            <Search />
          </div>
        )}
        {header.themeToggle && <ThemeMenu />}
      </div>
    </div>
  )
}

<script>
  /*
   * Starlight's own mobile menu state, driven from here rather than mirrored:
   * the attribute it keys the overlay and the scroll lock on, `inert` on the
   * frame behind the pane, and the button's `aria-expanded`. One state is what
   * keeps the lock and the pane from disagreeing, and a lock held over a pane
   * that never opened is what disagreement looks like.
   * See AmbiqAI/helia-ui#88.
   *
   * The listeners are delegated and bound at module scope, which a document
   * runs once: a view transition swaps the bar out from under them and they
   * stay bound, and bound once.
   */
  const EXPANDED = 'data-mobile-menu-expanded';

  const button = () =>
    document.querySelector<HTMLButtonElement>('[data-helia-sidebar-toggle]');

  const setExpanded = (expanded: boolean) => {
    document.body.toggleAttribute(EXPANDED, expanded);
    document
      .querySelectorAll<HTMLElement>('.main-frame, .sl-skip-link')
      .forEach((element) => element.toggleAttribute('inert', expanded));
    button()?.setAttribute('aria-expanded', String(expanded));
  };

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    if (target.closest('[data-helia-sidebar-toggle]')) {
      setExpanded(!document.body.hasAttribute(EXPANDED));
      return;
    }

    /* A link in the pane navigates under the overlay, so closing is what
       leaves the page it goes to readable. */
    if (target.closest('#starlight__sidebar a')) setExpanded(false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    if (!document.body.hasAttribute(EXPANDED)) return;
    setExpanded(false);
    button()?.focus();
  });

  /* Above the collapse point the pane is part of the page and the button is
     gone, so an open overlay would have nothing left to close it. */
  matchMedia('(min-width: 62rem)').addEventListener('change', () =>
    setExpanded(false),
  );

  document.addEventListener('astro:after-swap', () => setExpanded(false));
</script>
