---
// The three built-ins come through Starlight's own virtual modules rather than
// by package path, so a site that overrides one of them still gets its own
// here. `Pagination` is the seam the hub uses to keep its workspace-aware
// version without the package knowing what a workspace is.
import EditLink from 'virtual:starlight/components/EditLink';
import LastUpdated from 'virtual:starlight/components/LastUpdated';
import Pagination from 'virtual:starlight/components/Pagination';
import config from 'virtual:helia-ui/starlight-config';

import AmbiqLogo from './AmbiqLogo.astro';

const { links, logo, tagline } = config.footer;
const year = new Date().getFullYear();
---

<footer class="helia-content-footer">
  <div class="page-meta">
    <EditLink />
    <LastUpdated />
  </div>

  <Pagination />

  <div class="brand-footer">
    <div class="brand-lockup">
      {
        logo === 'ambiq' && (
          <a
            class="ambiq-link"
            href="https://ambiq.com/"
            aria-label="Ambiq home"
          >
            <AmbiqLogo tone="adaptive" class="footer-logo" />
          </a>
        )
      }
      {tagline && <p>{tagline}</p>}
    </div>

    <nav class="footer-links" aria-label="Footer">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
  </div>

  <p class="copyright">© {year} Ambiq Micro, Inc.</p>
</footer>

<style>
  .helia-content-footer {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    gap: var(--helia-space-5);
  }

  .page-meta {
    color: var(--sl-color-gray-3);
    display: flex;
    flex-wrap: wrap;
    font-size: var(--sl-text-sm);
    gap: var(--helia-space-3) calc(var(--helia-space-6) + var(--helia-space-4));
    justify-content: space-between;
    margin-top: calc(var(--helia-space-6) + var(--helia-space-4));
  }

  .page-meta > :global(p:only-child) {
    margin-inline-start: auto;
  }

  .brand-footer {
    align-items: start;
    border-top: 1px solid var(--sl-color-hairline);
    display: grid;
    gap: var(--helia-space-6);
    grid-template-columns: minmax(14rem, 1fr) auto;
    margin-top: var(--helia-space-4);
    padding-top: var(--helia-space-6);
  }

  .brand-lockup {
    display: grid;
    gap: var(--helia-space-4);
    justify-items: start;
  }

  .ambiq-link {
    color: inherit;
    display: inline-flex;
    text-decoration: none;
  }

  .ambiq-link:focus-visible,
  .footer-links a:focus-visible {
    border-radius: var(--helia-radius-xs);
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }

  .footer-logo {
    width: 6.4rem;
  }

  .brand-lockup p,
  .copyright {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-xs);
    line-height: 1.5;
    margin: 0;
  }

  .brand-lockup p {
    max-width: 25rem;
  }

  .footer-links {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--helia-space-1) var(--helia-space-4);
    justify-content: end;
  }

  .footer-links a {
    align-items: center;
    color: var(--sl-color-gray-2);
    display: inline-flex;
    font-size: var(--sl-text-xs);
    font-weight: var(--helia-weight-medium);
    min-height: 2rem;
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--sl-color-white);
  }

  .copyright {
    padding-bottom: var(--helia-space-5);
  }

  @container (max-width: 40rem) {
    .brand-footer {
      grid-template-columns: 1fr;
    }

    .footer-links {
      justify-content: start;
    }
  }
</style>
